# --- Galaxy Digital ---
API_KEY=
EMAIL=
PASSWORD=

# --- Google Calendar ---
CLIENT_ID=
CLIENT_SECRET=
CALENDAR_ID=

# --- Slack failure notifications (optional) ---
WEBHOOK_URL=

# --- SQLite store ---
GALAXY_DB_PATH=galaxy_sync.sqlite3

# --- Digest email (optional; leave DIGEST_EMAIL_TO blank to disable) ---
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
DIGEST_SUBJECT_PREFIX=Galaxy Digital
DIGEST_LOOKBACK_DAYS=1
DIGEST_REPEAT_WINDOW=30
DIGEST_REPEAT_MIN=2
# Cadence: daily@HH:MM | hourly | off
DIGEST_SCHEDULE=daily@21:00

# --- SMTP (used by the digest AND by transactional email templates) ---
# Google Workspace setup:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@yourdomain.com           (the Workspace user that will send)
#   SMTP_PASS=<App password from Google>   (Security -> App passwords)
#   SMTP_TLS=yes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=yes

# Optional explicit From: header. Defaults to SMTP_USER.
EMAIL_FROM=

# Organization name surfaced in email templates as {{org_name}}.
WEB_ORG_NAME=

# Set to yes to enable the background auto-email scanner. Without it the
# /emails page still lets you save templates and send them manually, but
# the trigger conditions (no_show_24h etc) won't fire on their own.
AUTO_EMAILS_ENABLED=no

# Render emails and write to email_sends WITHOUT actually contacting
# SMTP. Useful for the first deploy or after editing a template.
EMAIL_DRY_RUN=no

# --- Web viewer ---
# REQUIRED to enable the page; without it the server returns 503.
WEB_PASSWORD=
WEB_USERNAME=volunteer
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_REFRESH_SECS=60

# Absolute base URL the page is reachable at from outside the box --
# used to build clickable volunteer-name links in the email digest.
# Leave blank to keep names as plain text in the digest.
# Example LAN values:
#     WEB_PUBLIC_URL=http://eink.local:8765
#     WEB_PUBLIC_URL=http://192.168.1.42:8765
# Behind nginx + TLS:
#     WEB_PUBLIC_URL=https://volunteer-status.example.org
WEB_PUBLIC_URL=

# When yes, the "Mark in"/"Mark out"/Undo buttons on /shift/{id} also
# POST/PUT/DELETE the corresponding /hours record in Galaxy Digital so
# their reports reflect the change. Local override is still authoritative
# for the calendar + page rendering; this only affects what Galaxy
# Digital admin sees. Default: no -- buttons are local-only.
WEB_CHECKIN_POSTS_TO_GALAXY=no
