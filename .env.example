# --- Galaxy Digital ---
API_KEY=
EMAIL=
PASSWORD=

# --- Google Calendar ---
CLIENT_ID=
CLIENT_SECRET=
CALENDAR_ID=

# --- Slack failure notifications (optional) ---
WEBHOOK_URL=

# --- SQLite store ---
GALAXY_DB_PATH=galaxy_sync.sqlite3

# --- Digest email (optional; leave DIGEST_EMAIL_TO blank to disable) ---
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
DIGEST_SUBJECT_PREFIX=Galaxy Digital
DIGEST_LOOKBACK_DAYS=1
DIGEST_REPEAT_WINDOW=30
DIGEST_REPEAT_MIN=2
# Cadence: daily@HH:MM | hourly | off
DIGEST_SCHEDULE=daily@21:00

# --- SMTP (used only when DIGEST_EMAIL_TO is set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=yes

# --- Web viewer ---
# REQUIRED to enable the page; without it the server returns 503.
WEB_PASSWORD=
WEB_USERNAME=volunteer
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_REFRESH_SECS=60

# Absolute base URL the page is reachable at from outside the box --
# used to build clickable volunteer-name links in the email digest.
# Leave blank to keep names as plain text in the digest.
# Example LAN values:
#     WEB_PUBLIC_URL=http://eink.local:8765
#     WEB_PUBLIC_URL=http://192.168.1.42:8765
# Behind nginx + TLS:
#     WEB_PUBLIC_URL=https://volunteer-status.example.org
WEB_PUBLIC_URL=

# When yes, the "Mark in"/"Mark out"/Undo buttons on /shift/{id} also
# POST/PUT/DELETE the corresponding /hours record in Galaxy Digital so
# their reports reflect the change. Local override is still authoritative
# for the calendar + page rendering; this only affects what Galaxy
# Digital admin sees. Default: no -- buttons are local-only.
WEB_CHECKIN_POSTS_TO_GALAXY=no
